{
  "command": "../../bin/run-node.sh",
  "args": ["main.mjs"],
  "restart_policy": "always",
  "display_name": "时空驾驶舱",
  "description": "AGY 时空驾驶舱：可视化会话分支树（Fork + Git Worktree）、工作区与系统资源管理器（Finder/Explorer 定位）、256K 上下文防失忆预警、全本地历史检索导出及类 agy-powertools 原生右键/气泡增强。",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": true
  },
  "ui_config": {
    "display_name": "时空驾驶舱",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "时空驾驶舱"
      },
      {
        "path": "/sidebar",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_SIDEBAR",
        "title": "时空驾驶舱"
      }
    ]
  }
}
